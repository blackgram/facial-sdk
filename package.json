{
  "name": "@diguiux/liveness-sdk",
  "version": "0.1.0",
  "description": "Liveness capture SDK for React Native",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils": {
      "source": "./src/utils/index.ts",
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "expo-brightness": ">=12",
    "expo-image-manipulator": ">=12",
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-reanimated": ">=3",
    "react-native-safe-area-context": ">=4",
    "react-native-svg": ">=13",
    "react-native-vision-camera": ">=4",
    "react-native-vision-camera-face-detector": ">=2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "typescript": "~5.5.0"
  },
  "private": true,
  "license": "UNLICENSED"
}
